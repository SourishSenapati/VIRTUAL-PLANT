<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>virtual_refinery</name>
  <version>1.0.0</version>
  <description>
    ROS 2 Digital Twin and Physical Process Simulator for a Virtual Petroleum Refinery Complex.
    Models CDU, VDU, FCCU, Hydrocracker, Delayed Coker, stream routing, and process safety systems.
  </description>
  <maintainer email="sourishsenapati791@gmail.com">Sourish Senapati</maintainer>
  <license>Educational Non-Commercial with Mandatory Attribution</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
