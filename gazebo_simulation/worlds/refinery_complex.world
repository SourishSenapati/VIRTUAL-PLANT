<?xml version="1.0" ?>
<!--
  VIRTUAL REFINERY COMPLEX - GAZEBO SIMULATION WORLD
  Author: Sourish Senapati (Jadavpur University, Chemical Engineering)
  Includes: CDU (C-101), VDU (C-102), FCCU (R-201/202), Hydrocracker (R-301),
            Delayed Coker (V-401A/B), Fired Furnaces, Pipe Racks, Tank Farm, Flare Stack.
-->
<sdf version="1.6">
  <world name="refinery_complex_world">
    <!-- Physics Engine Configuration (ODE accurate dynamic simulation) -->
    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Scene Lighting & Atmosphere -->
    <scene>
      <ambient>0.4 0.45 0.5 1.0</ambient>
      <background>0.6 0.7 0.85 1.0</background>
      <shadows>true</shadows>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
    </scene>

    <!-- Directional Sun Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 120 0 0.45 0.65</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.5 -1.0</direction>
    </light>

    <!-- High-Mast Floodlight Over Battery Limits -->
    <light type="point" name="plant_floodlight_1">
      <pose>25 10 35 0 0 0</pose>
      <diffuse>1.0 0.95 0.8 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>120</range>
        <constant>0.5</constant>
        <linear>0.02</linear>
        <quadratic>0.002</quadratic>
      </attenuation>
    </light>

    <!-- Ground Plane (Industrial Concrete / Asphalt Pad) -->
    <model name="refinery_ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>350 350</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>350 350</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.35 0.37 0.40 1</ambient>
            <diffuse>0.40 0.42 0.45 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 1. ATMOSPHERIC CRUDE DISTILLATION COLUMN (CDU / C-101) -->
    <model name="cdu_column">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="cdu_link">
        <!-- Foundation -->
        <collision name="cdu_fnd_col">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry><cylinder><radius>3.8</radius><length>1.5</length></cylinder></geometry>
        </collision>
        <visual name="cdu_fnd_vis">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry><cylinder><radius>3.8</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
        <!-- Skirt -->
        <collision name="cdu_skirt_col">
          <pose>0 0 5.0 0 0 0</pose>
          <geometry><cylinder><radius>2.6</radius><length>7.0</length></cylinder></geometry>
        </collision>
        <visual name="cdu_skirt_vis">
          <pose>0 0 5.0 0 0 0</pose>
          <geometry><cylinder><radius>2.6</radius><length>7.0</length></cylinder></geometry>
          <material><ambient>0.25 0.28 0.30 1</ambient><diffuse>0.35 0.38 0.40 1</diffuse></material>
        </visual>
        <!-- Main Column Body (5.2m OD x 54m height) -->
        <collision name="cdu_body_col">
          <pose>0 0 35.5 0 0 0</pose>
          <geometry><cylinder><radius>2.6</radius><length>54.0</length></cylinder></geometry>
        </collision>
        <visual name="cdu_body_vis">
          <pose>0 0 35.5 0 0 0</pose>
          <geometry><cylinder><radius>2.6</radius><length>54.0</length></cylinder></geometry>
          <material><ambient>0.7 0.75 0.8 1</ambient><diffuse>0.8 0.85 0.9 1</diffuse><specular>0.6 0.6 0.6 1</specular></material>
        </visual>
        <!-- Top Dished Head -->
        <visual name="cdu_top_head">
          <pose>0 0 62.5 0 0 0</pose>
          <geometry><sphere><radius>2.6</radius></sphere></geometry>
          <material><ambient>0.7 0.75 0.8 1</ambient><diffuse>0.8 0.85 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 2. VACUUM DISTILLATION COLUMN (VDU / C-102) -->
    <model name="vdu_column">
      <static>true</static>
      <pose>18 0 0 0 0 0</pose>
      <link name="vdu_link">
        <!-- Sump & Skirt -->
        <collision name="vdu_skirt_col">
          <pose>0 0 4.0 0 0 0</pose>
          <geometry><cylinder><radius>3.2</radius><length>8.0</length></cylinder></geometry>
        </collision>
        <visual name="vdu_skirt_vis">
          <pose>0 0 4.0 0 0 0</pose>
          <geometry><cylinder><radius>3.2</radius><length>8.0</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material>
        </visual>
        <!-- Lower Flash Zone Bulb (8.5m OD x 18m height) -->
        <collision name="vdu_bulb_col">
          <pose>0 0 17.0 0 0 0</pose>
          <geometry><cylinder><radius>4.25</radius><length>18.0</length></cylinder></geometry>
        </collision>
        <visual name="vdu_bulb_vis">
          <pose>0 0 17.0 0 0 0</pose>
          <geometry><cylinder><radius>4.25</radius><length>18.0</length></cylinder></geometry>
          <material><ambient>0.65 0.70 0.75 1</ambient><diffuse>0.75 0.80 0.85 1</diffuse><specular>0.5 0.5 0.5 1</specular></material>
        </visual>
        <!-- Upper Section (6.0m OD x 24m height) -->
        <collision name="vdu_upper_col">
          <pose>0 0 38.0 0 0 0</pose>
          <geometry><cylinder><radius>3.0</radius><length>24.0</length></cylinder></geometry>
        </collision>
        <visual name="vdu_upper_vis">
          <pose>0 0 38.0 0 0 0</pose>
          <geometry><cylinder><radius>3.0</radius><length>24.0</length></cylinder></geometry>
          <material><ambient>0.65 0.70 0.75 1</ambient><diffuse>0.75 0.80 0.85 1</diffuse></material>
        </visual>
        <!-- Vacuum Transfer Duct (Overhead line to ejectors) -->
        <visual name="vdu_vac_line">
          <pose>2.5 0 50.0 0 1.57 0</pose>
          <geometry><cylinder><radius>1.1</radius><length>5.0</length></cylinder></geometry>
          <material><ambient>0.8 0.4 0.1 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 3. FLUID CATALYTIC CRACKING UNIT (FCCU / R-201 & R-202) -->
    <model name="fccu_complex">
      <static>true</static>
      <pose>40 12 0 0 0 0</pose>
      <link name="fccu_link">
        <!-- FCC Regenerator (Large 11.5m diameter vessel) -->
        <collision name="fcc_regen_col">
          <pose>0 0 20.0 0 0 0</pose>
          <geometry><cylinder><radius>5.75</radius><length>32.0</length></cylinder></geometry>
        </collision>
        <visual name="fcc_regen_vis">
          <pose>0 0 20.0 0 0 0</pose>
          <geometry><cylinder><radius>5.75</radius><length>32.0</length></cylinder></geometry>
          <material><ambient>0.85 0.65 0.35 1</ambient><diffuse>0.95 0.75 0.40 1</diffuse></material>
        </visual>
        <!-- FCC Reactor / Disengager (Side by side at x = -8m, y = 4m) -->
        <collision name="fcc_rx_col">
          <pose>-8.0 4.0 22.0 0 0 0</pose>
          <geometry><cylinder><radius>2.4</radius><length>28.0</length></cylinder></geometry>
        </collision>
        <visual name="fcc_rx_vis">
          <pose>-8.0 4.0 22.0 0 0 0</pose>
          <geometry><cylinder><radius>2.4</radius><length>28.0</length></cylinder></geometry>
          <material><ambient>0.75 0.60 0.40 1</ambient><diffuse>0.85 0.70 0.45 1</diffuse></material>
        </visual>
        <!-- Riser Tube (Vertical 1.4m diameter x 38m height) -->
        <visual name="fcc_riser_vis">
          <pose>-8.0 4.0 19.0 0 0 0</pose>
          <geometry><cylinder><radius>0.7</radius><length>38.0</length></cylinder></geometry>
          <material><ambient>0.9 0.2 0.2 1</ambient><diffuse>0.95 0.25 0.25 1</diffuse></material>
        </visual>
        <!-- Catalyst Transfer Standpipes -->
        <visual name="fcc_standpipe_1">
          <pose>-4.0 2.0 10.0 0 0.8 0.4</pose>
          <geometry><cylinder><radius>0.45</radius><length>12.0</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 4. HYDROCRACKING UNIT (HCU / R-301 & R-302) -->
    <model name="hydrocracker_unit">
      <static>true</static>
      <pose>40 -16 0 0 0 0</pose>
      <link name="hcu_link">
        <!-- Reactor 1 (3.6m ID x 28m heavy wall) -->
        <collision name="hcu_r1_col">
          <pose>0 0 16.0 0 0 0</pose>
          <geometry><cylinder><radius>1.8</radius><length>28.0</length></cylinder></geometry>
        </collision>
        <visual name="hcu_r1_vis">
          <pose>0 0 16.0 0 0 0</pose>
          <geometry><cylinder><radius>1.8</radius><length>28.0</length></cylinder></geometry>
          <material><ambient>0.2 0.3 0.5 1</ambient><diffuse>0.25 0.4 0.65 1</diffuse><specular>0.7 0.7 0.8 1</specular></material>
        </visual>
        <!-- Reactor 2 (3.8m ID x 32m heavy wall) -->
        <collision name="hcu_r2_col">
          <pose>6.5 0 18.0 0 0 0</pose>
          <geometry><cylinder><radius>1.9</radius><length>32.0</length></cylinder></geometry>
        </collision>
        <visual name="hcu_r2_vis">
          <pose>6.5 0 18.0 0 0 0</pose>
          <geometry><cylinder><radius>1.9</radius><length>32.0</length></cylinder></geometry>
          <material><ambient>0.2 0.3 0.5 1</ambient><diffuse>0.25 0.4 0.65 1</diffuse><specular>0.7 0.7 0.8 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- 5. DELAYED COKING DRUMS (DCU / V-401A & V-401B) -->
    <model name="delayed_coking_drums">
      <static>true</static>
      <pose>22 32 0 0 0 0</pose>
      <link name="coker_link">
        <!-- Coke Drum A (8.5m ID x 34m height) -->
        <collision name="coker_a_col">
          <pose>-5.5 0 21.0 0 0 0</pose>
          <geometry><cylinder><radius>4.25</radius><length>34.0</length></cylinder></geometry>
        </collision>
        <visual name="coker_a_vis">
          <pose>-5.5 0 21.0 0 0 0</pose>
          <geometry><cylinder><radius>4.25</radius><length>34.0</length></cylinder></geometry>
          <material><ambient>0.3 0.35 0.4 1</ambient><diffuse>0.4 0.45 0.5 1</diffuse></material>
        </visual>
        <!-- Coke Drum B (8.5m ID x 34m height) -->
        <collision name="coker_b_col">
          <pose>5.5 0 21.0 0 0 0</pose>
          <geometry><cylinder><radius>4.25</radius><length>34.0</length></cylinder></geometry>
        </collision>
        <visual name="coker_b_vis">
          <pose>5.5 0 21.0 0 0 0</pose>
          <geometry><cylinder><radius>4.25</radius><length>34.0</length></cylinder></geometry>
          <material><ambient>0.3 0.35 0.4 1</ambient><diffuse>0.4 0.45 0.5 1</diffuse></material>
        </visual>
        <!-- Decoking Derrick Tower on Drum Top -->
        <visual name="derrick_tower">
          <pose>0 0 46.0 0 0 0</pose>
          <geometry><box><size>18.0 6.0 20.0</size></geometry>
          <material><ambient>0.9 0.8 0.2 1</ambient><diffuse>0.9 0.8 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 6. MULTI-TIER PROCESS PIPE RACK SPINE -->
    <model name="pipe_rack_spine">
      <static>true</static>
      <pose>20 -5 0 0 0 0</pose>
      <link name="rack_link">
        <!-- Long Transverse Beam Array -->
        <visual name="rack_structure">
          <pose>0 0 6.0 0 0 0</pose>
          <geometry><box><size>80.0 6.0 12.0</size></geometry>
          <material><ambient>0.2 0.2 0.25 1</ambient><diffuse>0.3 0.3 0.35 1</diffuse></material>
        </visual>
        <!-- High Pressure Steam Header Pipe (Yellow) -->
        <visual name="steam_header">
          <pose>0 1.5 10.5 0 1.57 0</pose>
          <geometry><cylinder><radius>0.4</radius><length>80.0</length></cylinder></geometry>
          <material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.95 0.85 0.1 1</diffuse></material>
        </visual>
        <!-- Hydrocarbon Header Pipe (Green) -->
        <visual name="hc_header">
          <pose>0 -1.5 6.5 0 1.57 0</pose>
          <geometry><cylinder><radius>0.5</radius><length>80.0</length></cylinder></geometry>
          <material><ambient>0.1 0.6 0.2 1</ambient><diffuse>0.15 0.7 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 7. ELEVATED REFINERY FLARE STACK (FL-501) -->
    <model name="flare_stack">
      <static>true</static>
      <pose>95 65 0 0 0 0</pose>
      <link name="flare_link">
        <!-- 90m Tall Flare Riser -->
        <collision name="flare_col">
          <pose>0 0 45.0 0 0 0</pose>
          <geometry><cylinder><radius>0.65</radius><length>90.0</length></cylinder></geometry>
        </collision>
        <visual name="flare_riser">
          <pose>0 0 45.0 0 0 0</pose>
          <geometry><cylinder><radius>0.65</radius><length>90.0</length></cylinder></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
        <!-- Flare Tip & Simulated Pilot Flame -->
        <visual name="flare_flame">
          <pose>0 0 92.5 0 0 0</pose>
          <geometry><cone><radius>1.8</radius><length>5.0</length></cone></geometry>
          <material>
            <ambient>1.0 0.4 0.0 1</ambient>
            <diffuse>1.0 0.5 0.0 1</diffuse>
            <emissive>1.0 0.6 0.1 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- 8. REFINERY STORAGE TANK FARM (TK-601 to TK-604) -->
    <model name="tank_farm">
      <static>true</static>
      <pose>-35 -35 0 0 0 0</pose>
      <link name="tanks_link">
        <!-- Crude Oil Storage Tank 1 (68m dia x 18.5m height) -->
        <collision name="tank1_col">
          <pose>0 0 9.25 0 0 0</pose>
          <geometry><cylinder><radius>18.0</radius><length>18.5</length></cylinder></geometry>
        </collision>
        <visual name="tank1_vis">
          <pose>0 0 9.25 0 0 0</pose>
          <geometry><cylinder><radius>18.0</radius><length>18.5</length></cylinder></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
        <!-- Finished Diesel Product Tank 2 -->
        <visual name="tank2_vis">
          <pose>45 0 9.25 0 0 0</pose>
          <geometry><cylinder><radius>15.0</radius><length>18.5</length></cylinder></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
